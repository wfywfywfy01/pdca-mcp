# PDCA 经销商数据 MCP 服务配置
# 复制为 .env 并填写（.env 不入库）

# 生产 PostgreSQL（只读连接；建议用只读账号，别用 postgres 超级用户）
PDCA_MCP_DATABASE_URL=postgresql://pdca:password@10.100.0.176:5432/pdca

# MCP 访问密钥（逗号分隔，格式 key:role:owner_key）
# role: admin（全部）/ sales（按 owner_key 过滤门店）/ dealer（按门店过滤）
# 例如：admin-xxx:admin:  、  sales-yyy:sales:April
PDCA_MCP_API_KEYS=

# vertu-cli（后续实时 Sell-in 用，第一版可不配）
VERTU_COMMAND=vertu-cli
